# Copiar a .env.local para desarrollo, o cargar como variables de entorno del
# proyecto en Vercel (Settings → Environment Variables). Ninguna de estas es
# obligatoria para que el sitio funcione: sin ellas, el sitio muestra
# contenido institucional en vez de catálogo real, y las cotizaciones quedan
# solo en el log del servidor en vez de guardarse/enviarse por correo (ver
# app/api/quotes/route.ts).

# Base de datos propia del sitio (Neon) — NUNCA la del ERP (Dinaseg-ERP/server/db.js).
# Sin prefijo "PUBLIC_": Vercel rechaza ese prefijo para variables de tipo Secret.
DB_URL=

# SMTP para el correo de "nueva cotización" — mismos nombres de variable que
# Dinaseg-ERP, pero configurados de forma independiente acá.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contacto@dinaseg.cl

# Google Tag (Google Ads) para medir conversiones de "Solicitar cotización".
NEXT_PUBLIC_GTAG_ID=
